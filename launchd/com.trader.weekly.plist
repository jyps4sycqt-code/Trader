<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.trader.weekly</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <!-- Adjust this path if your repo lives elsewhere. -->
        <string>/Users/USERNAME/Trader/scripts/run_weekly.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/USERNAME/Trader</string>

    <!-- Sunday at 18:00 local time. (Weekday 0 = Sunday in launchd.) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>18</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/USERNAME/Trader/.cache/logs/launchd-weekly.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/USERNAME/Trader/.cache/logs/launchd-weekly.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
    </dict>
</dict>
</plist>
